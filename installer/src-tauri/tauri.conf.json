{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RapidTunes Setup",
  "version": "0.2.4",
  "identifier": "com.rapidtunes.installer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Installation de RapidTunes",
        "center": true,
        "width": 760,
        "height": 500,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png"
    ]
  }
}
