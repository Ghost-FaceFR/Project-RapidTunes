{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RapidTunes",
  "version": "0.2.9",
  "identifier": "com.rapidtunes.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    },
    "windows": [
      {
        "title": "RapidTunes",
        "center": true,
        "width": 980,
        "height": 600,
        "minWidth": 980,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "publisher": "Ghost Industry",
    "copyright": "© 2026 Ghost Industry. Tous droits réservés.",
    "category": "Music",
    "shortDescription": "Lecteur et téléchargeur de médias",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
