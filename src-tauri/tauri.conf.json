{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RapidTunes",
  "version": "0.1.0",
  "identifier": "com.rapidtunes.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    },
    "windows": [
      {
        "title": "RapidTunes",
        "center": true,
        "width": 980,
        "height": 600,
        "minWidth": 980,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ]
  }
}
